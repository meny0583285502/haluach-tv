<?xml version="1.0" encoding="utf-8"?>
<!-- תעודות האבטחה של נטפרי (מורדות אוטומטית בזמן הבנייה ל-res/raw/netfree_cas.pem) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/netfree_cas" />
        </trust-anchors>
    </base-config>
</network-security-config>
